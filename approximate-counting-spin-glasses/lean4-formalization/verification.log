SpinGlass.HigherOrderTotalCost.end_to_end {p : ℕ} {B : ℝ} (hp : 3 ≤ p) (hB : 0 < B)
  (hBT : B < SpinGlass.DesignConstants.betaThreshold p) :
  ∃ C,
    0 < C ∧
      ∀ (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ],
        SpinGlass.Disorder.SymmetricLaw μ →
          SpinGlass.Disorder.UnitSecondMoment μ →
            ∀ (N : ℕ),
              p ≤ N →
                ∀ (beta epsilon delta : ℝ),
                  0 ≤ beta →
                    beta ≤ B →
                      0 < epsilon →
                        epsilon < 1 →
                          0 < delta →
                            delta < 1 →
                              (SpinGlass.Disorder.iidLaw μ).real
                                    {J |
                                      epsilon <
                                        |(SpinGlass.HigherOrderTotalCost.countedTotal p N B beta epsilon delta
                                                J).value -
                                            SpinGlass.CountingReduction.targetLog p N beta J|} ≤
                                  SpinGlass.CountingReduction.remainder μ p N B + delta ∧
                                ∀ (J : Finset (Fin N) → ℝ),
                                  ↑(SpinGlass.HigherOrderTotalCost.countedTotal p N B beta epsilon delta J).operations ≤
                                    C * ↑N ^ C * epsilon ^ (-C) * delta ^ (-C)
SpinGlass.SKTotalCost.end_to_end {B : ℝ} (hB : 0 < B) (hBT : B < SpinGlass.DesignConstants.betaThreshold 2) :
  ∃ C,
    0 < C ∧
      ∀ (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ],
        SpinGlass.Disorder.SymmetricLaw μ →
          SpinGlass.Disorder.UnitSecondMoment μ →
            ∀ (N : ℕ),
              2 ≤ N →
                ∀ (beta epsilon delta : ℝ),
                  0 ≤ beta →
                    beta ≤ B →
                      0 < epsilon →
                        epsilon < 1 →
                          ∀ (hd : 0 < delta),
                            delta < 1 →
                              ((SpinGlass.SKUniformAlgorithm.randomLaw N B
                                            (SpinGlass.CountingReduction.mseBudget 2 B epsilon delta)).prod
                                        (SpinGlass.Disorder.iidLaw μ)).real
                                    {χJ |
                                      epsilon <
                                        |(SpinGlass.SKTotalCost.countedTotal N B beta epsilon delta hB hBT hd χJ.1
                                                χJ.2).value -
                                            SpinGlass.CountingReduction.targetLog 2 N beta χJ.2|} ≤
                                  SpinGlass.CountingReduction.remainder μ 2 N B + delta ∧
                                ∀
                                  (χ :
                                    SpinGlass.SKUniformAlgorithm.Randomness N B
                                      (SpinGlass.CountingReduction.mseBudget 2 B epsilon delta))
                                  (J : Finset (Fin N) → ℝ),
                                  ↑(SpinGlass.SKTotalCost.countedTotal N B beta epsilon delta hB hBT hd χ
                                          J).operations ≤
                                    C * ↑N ^ C * epsilon ^ (-C) * delta ^ (-C)
