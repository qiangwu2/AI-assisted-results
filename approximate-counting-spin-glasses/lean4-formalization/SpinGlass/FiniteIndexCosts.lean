import SpinGlass.InputPreparation
import Mathlib.Data.List.Sublists

/-! Finite index algorithms and their comparison/generation costs. In particular,
restricted subsets are generated by a pruned include/exclude recursion, never by
filtering the ambient powerset. -/
noncomputable section
namespace SpinGlass.FiniteIndexCosts
open scoped BigOperators
variable {α : Type*} [DecidableEq α]

structure Decision where
  value : Bool
  comparisons : ℕ

def member (a : α) : List α → Decision
  | [] => ⟨false,0⟩
  | b::bs => if a=b then ⟨true,1⟩ else
      let tail := member a bs
      ⟨tail.value,tail.comparisons+1⟩

@[simp] theorem member_value (a : α) (xs : List α) : (member a xs).value = true ↔ a∈xs := by
  induction xs with
  | nil => simp [member]
  | cons x xs ih => by_cases h : a=x <;> simp [member,h,ih]

theorem member_comparisons (a : α) (xs : List α) : (member a xs).comparisons ≤ xs.length := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp only [member,List.length_cons]; split_ifs <;> dsimp <;> omega

def subset (ys : List α) : List α → Decision
  | [] => ⟨true,0⟩
  | x::xs =>
      let m := member x ys
      if m.value then
        let tail := subset ys xs
        ⟨tail.value,m.comparisons+tail.comparisons⟩
      else ⟨false,m.comparisons⟩

@[simp] theorem subset_value (xs ys : List α) : (subset ys xs).value = true ↔ xs ⊆ ys := by
  induction xs with
  | nil => simp [subset]
  | cons x xs ih =>
    simp only [subset]
    by_cases h : (member x ys).value = true
    · simp [h,ih,(member_value x ys).mp h,List.cons_subset]
    · simp [h,show x∉ys from fun hx => h ((member_value x ys).mpr hx),List.cons_subset]

theorem subset_comparisons (xs ys : List α) :
    (subset ys xs).comparisons ≤ xs.length*ys.length := by
  induction xs with
  | nil => simp [subset]
  | cons x xs ih =>
    have hm := member_comparisons x ys
    simp only [subset,List.length_cons]
    split_ifs <;> dsimp <;> nlinarith

def finsetSubset (s t : Finset α) : Decision := subset t.toList s.toList

@[simp] theorem finsetSubset_value (s t : Finset α) :
    (finsetSubset s t).value = true ↔ s ⊆ t := by
  simp [finsetSubset,List.subset_def,Finset.subset_iff]

theorem finsetSubset_comparisons (s t : Finset α) :
    (finsetSubset s t).comparisons ≤ s.card*t.card := by
  simpa [finsetSubset] using subset_comparisons s.toList t.toList

def finsetEqual (s t : Finset α) : Decision :=
  let h := finsetSubset s t
  if h.value then
    let k := finsetSubset t s
    ⟨k.value,h.comparisons+k.comparisons⟩
  else ⟨false,h.comparisons⟩

@[simp] theorem finsetEqual_value (s t : Finset α) :
    (finsetEqual s t).value = true ↔ s=t := by
  unfold finsetEqual
  by_cases h : (finsetSubset s t).value = true
  · simp only [h,if_true,finsetSubset_value]
    exact ⟨fun ht => Finset.Subset.antisymm ((finsetSubset_value s t).mp h) ht,
      fun he => by rw [he]⟩
  · simp only [h,Bool.false_eq_true,if_false]
    exact iff_of_false (by decide) (fun he => h ((finsetSubset_value s t).mpr (he ▸ Finset.Subset.refl _)))

theorem finsetEqual_comparisons (s t : Finset α) :
    (finsetEqual s t).comparisons ≤ 2*s.card*t.card := by
  have h := finsetSubset_comparisons s t
  have k := finsetSubset_comparisons t s
  dsimp only [finsetEqual]
  split_ifs <;> dsimp <;> nlinarith

open SpinGlass.InputPreparation in
def lookup (e : Finset α) : List (Finset α × EdgeData) → EdgeData × ℕ
  | [] => (⟨0,0,0⟩,0)
  | (e',d)::es =>
      let h := finsetEqual e e'
      if h.value then (d,h.comparisons) else
        let tail := lookup e es
        (tail.1,h.comparisons+tail.2)

@[simp] theorem lookup_value (e : Finset α) (es : List (Finset α × InputPreparation.EdgeData)) :
    (lookup e es).1 = InputPreparation.lookupEdge e es := by
  induction es with
  | nil => rfl
  | cons x es ih =>
    by_cases h : e=x.1
    · simp [lookup,InputPreparation.lookupEdge,h]
    · have hn : (finsetEqual e x.1).value ≠ true := fun he => h ((finsetEqual_value e x.1).mp he)
      simp [lookup,InputPreparation.lookupEdge,hn,h,ih]

theorem lookup_comparisons {N : ℕ} (e : Finset α)
    (es : List (Finset α × InputPreparation.EdgeData)) (he : e.card ≤ N)
    (hes : ∀ x∈es, x.1.card ≤ N) : (lookup e es).2 ≤ 2*N^2*es.length := by
  induction es with
  | nil => simp [lookup]
  | cons x es ih =>
    have hx := hes x (by simp)
    have ht := ih (fun x hx => hes x (by simp [hx]))
    have hc : (finsetEqual e x.1).comparisons ≤ 2*N^2 :=
      (finsetEqual_comparisons e x.1).trans (by nlinarith)
    simp only [lookup,List.length_cons]
    split_ifs <;> dsimp <;> nlinarith

/-- The comparison bound follows the actual short-circuit cache scan. -/
theorem lookup_comparisons_visits {N : ℕ} (e : Finset α)
    (es : List (Finset α × InputPreparation.EdgeData)) (he : e.card ≤ N)
    (hes : ∀ x∈es, x.1.card ≤ N) :
    (lookup e es).2 ≤ 2*N^2*InputPreparation.lookupVisits e es := by
  induction es with
  | nil => simp [lookup,InputPreparation.lookupVisits]
  | cons x es ih =>
    have hx := hes x (by simp)
    have ht := ih (fun x hx => hes x (by simp [hx]))
    have hc : (finsetEqual e x.1).comparisons ≤ 2*N^2 :=
      (finsetEqual_comparisons e x.1).trans (by nlinarith)
    by_cases h : e=x.1
    · simpa [lookup,InputPreparation.lookupVisits,h] using hc
    · have hn : (finsetEqual e x.1).value ≠ true := fun he => h ((finsetEqual_value _ _).mp he)
      simp only [lookup,hn,if_false,InputPreparation.lookupVisits,h,Bool.false_eq_true]
      nlinarith

/-- Include/exclude generator with an early rejection of impossible lengths. -/
def chooseLists : ℕ → List α → List (List α)
  | 0, _ => [[]]
  | _+1, [] => []
  | k+1, x::xs => if xs.length < k then [] else
      chooseLists (k+1) xs ++ (chooseLists k xs).map (List.cons x)

theorem chooseLists_eq (k : ℕ) (xs : List α) : chooseLists k xs = xs.sublistsLen k := by
  induction xs generalizing k with
  | nil => cases k <;> simp [chooseLists]
  | cons x xs ih =>
    cases k with
    | zero => simp [chooseLists]
    | succ k =>
      by_cases h : xs.length < k
      · rw [chooseLists,if_pos h,List.sublistsLen_of_length_lt (by simp; omega)]
      · simp only [chooseLists,if_neg h,ih,List.sublistsLen_succ_cons]

@[simp] theorem chooseLists_length (k : ℕ) (xs : List α) :
    (chooseLists k xs).length = xs.length.choose k := by rw [chooseLists_eq,List.length_sublistsLen]

/-- Number of visited recursion nodes, charging the rejected branches as well. -/
def chooseNodes : ℕ → ℕ → ℕ
  | _, 0 => 1
  | 0, _+1 => 1
  | n+1, k+1 => if n < k then 1 else 1+chooseNodes n (k+1)+chooseNodes n k

theorem chooseNodes_impossible {n k : ℕ} (h : n < k) : chooseNodes n k = 1 := by
  cases n <;> cases k <;> simp_all [chooseNodes]

/-- The search tree is output-sensitive, including boundary cases k=0 and k=n. -/
theorem chooseNodes_le {n k : ℕ} (h : k ≤ n) :
    chooseNodes n k ≤ (2*n+1)*n.choose k := by
  induction n generalizing k with
  | zero =>
    have hk : k=0 := by omega
    simp [hk,chooseNodes]
  | succ n ih =>
    cases k with
    | zero => simp [chooseNodes]
    | succ k =>
      have hkn : k ≤ n := by omega
      rw [chooseNodes,if_neg (by omega),Nat.choose_succ_succ]
      have hi := ih hkn
      by_cases hk : k=n
      · subst k
        rw [chooseNodes_impossible (by omega : n<n+1),Nat.choose_succ_self,Nat.choose_self]
        simp only [Nat.choose_self] at hi
        omega
      · have hj := ih (show k+1≤n by omega)
        have hp : 1 ≤ n.choose k := Nat.choose_pos hkn
        nlinarith

theorem chooseNodes_le_all (n k : ℕ) :
    chooseNodes n k ≤ (2*n+1)*(n.choose k+1) := by
  by_cases h : k≤n
  · exact (chooseNodes_le h).trans (Nat.mul_le_mul_left _ (by omega))
  · rw [chooseNodes_impossible (by omega : n<k)]
    nlinarith

/-- Work charged by the literal generator: each node performs its length scan
and comparisons, then appends/maps the two saved child lists. -/
def chooseWork : ℕ → ℕ → ℕ
  | _, 0 => 1
  | 0, _+1 => 1
  | n+1, k+1 => if n < k then n+3 else
      n+3+chooseWork n (k+1)+chooseWork n k+n.choose (k+1)+n.choose k

theorem chooseWork_impossible {n k : ℕ} (h : n < k) : chooseWork n k ≤ n+2 := by
  cases n <;> cases k <;> simp_all [chooseWork] <;> omega

/-- Generation includes all comparison and list-construction work, not just
the size of the returned family. -/
theorem chooseWork_le {n k : ℕ} (h : k ≤ n) :
    chooseWork n k ≤ 4*(n+1)^2*n.choose k := by
  induction n generalizing k with
  | zero =>
    have hk : k=0 := by omega
    simp [hk,chooseWork]
  | succ n ih =>
    cases k with
    | zero => simp only [chooseWork,Nat.choose_zero_right,mul_one]; nlinarith
    | succ k =>
      have hkn : k≤n := by omega
      rw [chooseWork,if_neg (by omega),Nat.choose_succ_succ]
      have hi := ih hkn
      by_cases hk : k=n
      · subst k
        have hj := chooseWork_impossible (by omega : n<n+1)
        simp only [Nat.choose_self,Nat.choose_succ_self] at hi ⊢
        nlinarith
      · have hj := ih (show k+1≤n by omega)
        have hp : 1 ≤ n.choose k := Nat.choose_pos hkn
        nlinarith

theorem chooseWork_le_all (n k : ℕ) :
    chooseWork n k ≤ 4*(n+1)^2*(n.choose k+1) := by
  by_cases h : k≤n
  · exact (chooseWork_le h).trans (Nat.mul_le_mul_left _ (by omega))
  · have hh := chooseWork_impossible (by omega : n<k)
    have hp : 1≤n.choose k+1 := by omega
    nlinarith

structure Generated (α : Type*) where
  values : List α
  work : ℕ

/-- The costed program saves both recursive outputs before append/map. -/
def chooseExecution : ℕ → List α → Generated (List α)
  | 0, _ => ⟨[[]],1⟩
  | _+1, [] => ⟨[],1⟩
  | k+1, x::xs => if xs.length < k then ⟨[],xs.length+3⟩ else
      let left := chooseExecution (k+1) xs
      let right := chooseExecution k xs
      ⟨left.values ++ right.values.map (List.cons x),
        xs.length+3+left.work+right.work+left.values.length+right.values.length⟩

@[simp] theorem chooseExecution_values (k : ℕ) (xs : List α) :
    (chooseExecution k xs).values = chooseLists k xs := by
  induction xs generalizing k with
  | nil => cases k <;> rfl
  | cons x xs ih =>
    cases k with
    | zero => rfl
    | succ k => simp only [chooseExecution,chooseLists]; split_ifs <;> simp [ih]

@[simp] theorem chooseExecution_work (k : ℕ) (xs : List α) :
    (chooseExecution k xs).work = chooseWork xs.length k := by
  induction xs generalizing k with
  | nil => cases k <;> rfl
  | cons x xs ih =>
    cases k with
    | zero => rfl
    | succ k =>
      simp only [chooseExecution,chooseWork,List.length_cons]
      split_ifs <;> simp [ih]

/-- The generated list of finite subsets contains precisely the cardinality
layer, without an ambient-powerset filtering step. -/
def chosenFinsets (k : ℕ) (xs : List α) : List (Finset α) :=
  (chooseExecution k xs).values.map List.toFinset

theorem chosenFinsets_toFinset (k : ℕ) (xs : List α) (hn : xs.Nodup) :
    (chosenFinsets k xs).toFinset = xs.toFinset.powersetCard k := by
  ext s
  simp only [chosenFinsets,chooseExecution_values,chooseLists_eq,List.mem_toFinset,
    List.mem_map,List.mem_sublistsLen,Finset.mem_powersetCard]
  constructor
  · rintro ⟨l,⟨hl,hk⟩,rfl⟩
    refine ⟨?_,?_⟩
    · intro a ha
      exact List.mem_toFinset.mpr (hl.subset (List.mem_toFinset.mp ha))
    · rw [List.toFinset_card_of_nodup (hn.sublist hl),hk]
  · rintro ⟨hs,hk⟩
    let l := xs.filter (fun a => decide (a∈s))
    have hl : l.Sublist xs := List.filter_sublist
    have he : l.toFinset = s := by
      ext a
      simp only [l,List.mem_toFinset,List.mem_filter,decide_eq_true_eq]
      exact ⟨fun h => h.2,fun h => ⟨List.mem_toFinset.mp (hs h),h⟩⟩
    refine ⟨l,⟨hl,?_⟩,he⟩
    rw [← List.toFinset_card_of_nodup (hn.sublist hl),he,hk]

theorem chosenFinsets_length (k : ℕ) (xs : List α) :
    (chosenFinsets k xs).length = xs.length.choose k := by simp [chosenFinsets]

/-- Every subset is generated once; no deduplication pass is required. -/
theorem chosenFinsets_nodup (k : ℕ) (xs : List α) (hn : xs.Nodup) :
    (chosenFinsets k xs).Nodup := by
  apply (Multiset.toFinset_card_eq_card_iff_nodup (m := (chosenFinsets k xs : Multiset (Finset α)))).mp
  change (chosenFinsets k xs).toFinset.card = (chosenFinsets k xs).length
  rw [chosenFinsets_toFinset k xs hn,Finset.card_powersetCard,
    List.toFinset_card_of_nodup hn,chosenFinsets_length]

/-- Exact interface for replacing a powersetCard loop by the concrete generator. -/
theorem chosenFinsets_sum {R : Type*} [AddCommMonoid R] (s : Finset α) (k : ℕ) (f : Finset α → R) :
    ((chosenFinsets k s.toList).map f).sum = ∑ t∈s.powersetCard k, f t := by
  rw [← List.sum_toFinset _ (chosenFinsets_nodup k s.toList s.nodup_toList)]
  rw [chosenFinsets_toFinset k s.toList s.nodup_toList]
  simp

/-- The entire bounded support schedule has output-sensitive generation work. -/
theorem bounded_choose_work {n cutoff : ℕ} (hcut : cutoff ≤ n) :
    (∑ k∈Finset.range (cutoff+1),chooseWork n k) ≤
      4*(n+1)^2 * ∑ k∈Finset.range (cutoff+1),n.choose k := by
  rw [Finset.mul_sum]
  exact Finset.sum_le_sum (fun k hk => chooseWork_le (by have := Finset.mem_range.mp hk; omega))

/-- All-subset generation saves one child family and reuses it in both branches. -/
def allExecution : List α → Generated (List α)
  | [] => ⟨[[]],1⟩
  | x::xs =>
      let old := allExecution xs
      ⟨old.values ++ old.values.map (List.cons x),old.work+2*old.values.length+1⟩

@[simp] theorem allExecution_values (xs : List α) : (allExecution xs).values = xs.sublists' := by
  induction xs with
  | nil => rfl
  | cons x xs ih => simp [allExecution,ih]

@[simp] theorem allExecution_length (xs : List α) : (allExecution xs).values.length = 2^xs.length := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    simp only [allExecution,List.length_append,List.length_map,List.length_cons]
    rw [ih,pow_succ]
    omega

theorem allExecution_work (xs : List α) : (allExecution xs).work ≤ 4*(xs.length+1)*2^xs.length := by
  induction xs with
  | nil => simp [allExecution]
  | cons x xs ih =>
    simp only [allExecution,allExecution_length,List.length_cons,pow_succ]
    have hpow : 1≤2^xs.length := Nat.one_le_pow _ _ (by omega)
    nlinarith

/-- Binary spin strings, generated once per assignment with a saved child list. -/
def cubeExecution : ℕ → Generated (List Bool)
  | 0 => ⟨[[]],1⟩
  | n+1 =>
      let old := cubeExecution n
      ⟨old.values.map (List.cons false) ++ old.values.map (List.cons true),
        old.work+3*old.values.length+1⟩

@[simp] theorem cubeExecution_length (n : ℕ) : (cubeExecution n).values.length = 2^n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [cubeExecution,List.length_append,List.length_map,pow_succ]; rw [ih]; omega

theorem cubeExecution_mem (n : ℕ) (l : List Bool) : l∈(cubeExecution n).values ↔ l.length=n := by
  induction n generalizing l with
  | zero => simp [cubeExecution]
  | succ n ih =>
    cases l with
    | nil => simp [cubeExecution]
    | cons b l => cases b <;> simp [cubeExecution,ih]

theorem cubeExecution_work (n : ℕ) : (cubeExecution n).work ≤ 4*(n+1)*2^n := by
  induction n with
  | zero => simp [cubeExecution]
  | succ n ih =>
    simp only [cubeExecution,cubeExecution_length,pow_succ]
    have hpow : 1≤2^n := Nat.one_le_pow _ _ (by omega)
    nlinarith

theorem cubeExecution_work_exact (n : ℕ) : (cubeExecution n).work+2 = 3*2^n+n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simp only [cubeExecution,cubeExecution_length,pow_succ]
    nlinarith

theorem cubeExecution_work_sharp (n : ℕ) :
    (cubeExecution n).work ≤ (n+1)*(2^n+1) := by
  have h := cubeExecution_work_exact n
  by_cases hn : 2≤n
  · have hh := Nat.mul_le_mul_right (2^n) hn
    nlinarith
  · interval_cases n <;> norm_num [cubeExecution]

/-- List spin assignments converted to the canonical finite coordinate type. -/
def cubeAssignments (n : ℕ) : List (Fin n → Bool) :=
  (cubeExecution n).values.map (fun l i => (l[i.val]?).getD false)

theorem cubeAssignments_mem (n : ℕ) (σ : Fin n → Bool) : σ∈cubeAssignments n := by
  refine List.mem_map.mpr ⟨List.ofFn σ, (cubeExecution_mem _ _).mpr (by simp),?_⟩
  funext i
  simp

theorem cubeAssignments_toFinset (n : ℕ) : (cubeAssignments n).toFinset = Finset.univ := by
  ext σ
  simp only [List.mem_toFinset,Finset.mem_univ,iff_true]
  exact cubeAssignments_mem n σ

theorem cubeAssignments_nodup (n : ℕ) : (cubeAssignments n).Nodup := by
  apply (Multiset.toFinset_card_eq_card_iff_nodup (m := (cubeAssignments n : Multiset (Fin n → Bool)))).mp
  change (cubeAssignments n).toFinset.card = (cubeAssignments n).length
  rw [cubeAssignments_toFinset]
  simp [cubeAssignments]

theorem cubeAssignments_sum {R : Type*} [AddCommMonoid R] (n : ℕ) (f : (Fin n → Bool) → R) :
    ((cubeAssignments n).map f).sum = ∑ σ, f σ := by
  rw [← List.sum_toFinset _ (cubeAssignments_nodup n),cubeAssignments_toFinset]

theorem allExecution_work_ambient {N : ℕ} (xs : List α) (hn : xs.length≤N) :
    (allExecution xs).work ≤ 4*(N+1)^2*2^xs.length := by
  apply (allExecution_work xs).trans
  have hh : xs.length+1 ≤ (N+1)^2 := by nlinarith
  exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hh)

def allFinsets (xs : List α) : List (Finset α) := (allExecution xs).values.map List.toFinset

theorem allFinsets_toFinset (xs : List α) : (allFinsets xs).toFinset = xs.toFinset.powerset := by
  ext s
  simp only [allFinsets,allExecution_values,List.mem_toFinset,List.mem_map,List.mem_sublists',
    Finset.mem_powerset]
  constructor
  · rintro ⟨l,hl,rfl⟩ a ha
    exact List.mem_toFinset.mpr (hl.subset (List.mem_toFinset.mp ha))
  · intro hs
    let l := xs.filter (fun a => decide (a∈s))
    refine ⟨l,List.filter_sublist,?_⟩
    ext a
    simp only [l,List.mem_toFinset,List.mem_filter,decide_eq_true_eq]
    exact ⟨fun h => h.2,fun h => ⟨List.mem_toFinset.mp (hs h),h⟩⟩

theorem allFinsets_nodup (xs : List α) (hn : xs.Nodup) : (allFinsets xs).Nodup := by
  apply (Multiset.toFinset_card_eq_card_iff_nodup (m := (allFinsets xs : Multiset (Finset α)))).mp
  change (allFinsets xs).toFinset.card = (allFinsets xs).length
  rw [allFinsets_toFinset,Finset.card_powerset,List.toFinset_card_of_nodup hn]
  simp [allFinsets]

theorem allFinsets_sum {R : Type*} [AddCommMonoid R] (s : Finset α) (f : Finset α → R) :
    ((allFinsets s.toList).map f).sum = ∑ t∈s.powerset, f t := by
  rw [← List.sum_toFinset _ (allFinsets_nodup s.toList s.nodup_toList),allFinsets_toFinset]
  simp

/-- Packing a proved duplicate-free list requires no membership or deduplication
tests. The finite-set constructor retains the underlying list representation. -/
def packLists : (ls : List (List α)) → (∀ l∈ls,l.Nodup) → List (Finset α)
  | [], _ => []
  | l::ls, h => ⟨l,h l (by simp)⟩ :: packLists ls (fun a ha => h a (by simp [ha]))

theorem packLists_eq (ls : List (List α)) (h : ∀ l∈ls,l.Nodup) :
    packLists ls h = ls.map List.toFinset := by
  induction ls with
  | nil => rfl
  | cons l ls ih => simp only [packLists,List.map_cons,List.toFinset_eq,ih]

def certifiedChoices (k : ℕ) (xs : List α) (hn : xs.Nodup) : List (Finset α) :=
  packLists (chooseExecution k xs).values (fun l hl => hn.sublist
    ((List.mem_sublistsLen.mp (by simpa only [chooseExecution_values,chooseLists_eq] using hl)).1))

theorem certifiedChoices_eq (k : ℕ) (xs : List α) (hn : xs.Nodup) :
    certifiedChoices k xs hn = chosenFinsets k xs := packLists_eq _ _

theorem chooseWork_le_three {n k : ℕ} (h : k ≤ n) :
    chooseWork n k ≤ 3*(n+1)^2*n.choose k := by
  induction n generalizing k with
  | zero =>
    have hk : k=0 := by omega
    simp [hk,chooseWork]
  | succ n ih =>
    cases k with
    | zero => simp only [chooseWork,Nat.choose_zero_right,mul_one]; nlinarith
    | succ k =>
      have hkn : k≤n := by omega
      rw [chooseWork,if_neg (by omega),Nat.choose_succ_succ]
      have hi := ih hkn
      by_cases hk : k=n
      · subst k
        have hj := chooseWork_impossible (by omega : n<n+1)
        simp only [Nat.choose_self,Nat.choose_succ_self] at hi ⊢
        nlinarith
      · have hj := ih (show k+1≤n by omega)
        have hp : 1 ≤ n.choose k := Nat.choose_pos hkn
        nlinarith

/-- The advertised bound includes one certified packing visit per output. -/
theorem chooseWork_with_pack {n k : ℕ} (h : k ≤ n) :
    chooseWork n k+n.choose k ≤ 4*(n+1)^2*n.choose k := by
  have hg := chooseWork_le_three h
  have hn : 1≤(n+1)^2 := by nlinarith
  have hh := Nat.mul_le_mul_right (n.choose k) hn
  nlinarith

theorem bounded_choose_work_with_pack {n cutoff : ℕ} (hcut : cutoff ≤ n) :
    (∑ k∈Finset.range (cutoff+1),(chooseWork n k+n.choose k)) ≤
      4*(n+1)^2 * ∑ k∈Finset.range (cutoff+1),n.choose k := by
  rw [Finset.mul_sum]
  exact Finset.sum_le_sum (fun k hk => chooseWork_with_pack (by have := Finset.mem_range.mp hk; omega))

def certifiedAll (xs : List α) (hn : xs.Nodup) : List (Finset α) :=
  packLists (allExecution xs).values (fun l hl => hn.sublist
    (List.mem_sublists'.mp (by simpa only [allExecution_values] using hl)))

theorem certifiedAll_eq (xs : List α) (hn : xs.Nodup) :
    certifiedAll xs hn = allFinsets xs := packLists_eq _ _

theorem allExecution_work_exact (xs : List α) :
    (allExecution xs).work+1 = 2*2^xs.length+xs.length := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    simp only [allExecution,allExecution_length,List.length_cons,pow_succ]
    nlinarith

theorem allExecution_work_with_pack {N : ℕ} (xs : List α) (hn : xs.length≤N) :
    (allExecution xs).work+(allExecution xs).values.length ≤ 4*(N+1)^2*2^xs.length := by
  have he := allExecution_work_exact xs
  rw [allExecution_length]
  have hh : xs.length+1≤(N+1)^2 := by nlinarith
  have hp : 1≤2^xs.length := Nat.one_le_pow _ _ (by omega)
  have hm := Nat.mul_le_mul_right (2^xs.length) hh
  nlinarith

end SpinGlass.FiniteIndexCosts
