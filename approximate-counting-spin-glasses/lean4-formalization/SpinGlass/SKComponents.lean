import SpinGlass.Expansion
import Mathlib.Logic.Relation

/-!
# Canonical decomposition of a selected graph at its branch vertices

Components are constructed from the actual selected edges. Two edges are joined
when they meet at a vertex outside the proposed branching set; the equivalence
closure of this relation gives a canonical partition. No decomposition function,
bijection, or uniqueness statement is assumed.
-/

noncomputable section

namespace SpinGlass.SKComponents

open scoped BigOperators

variable {V E : Type*} [Fintype V] [DecidableEq V] [DecidableEq E]

/-- Selected edges are adjacent for decomposition when they share an outside vertex. -/
def adjacentOutside (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (e f : Γ) : Prop := ∃ v, v ∉ A ∧ v ∈ incidence e ∧ v ∈ incidence f

/-- The equivalence relation generated by actual outside-vertex adjacencies. -/
def Related (incidence : E → Finset V) (A : Finset V) (Γ : Finset E) (e f : Γ) : Prop :=
  Relation.EqvGen (adjacentOutside incidence A Γ) e f

theorem related_refl (incidence : E → Finset V) (A : Finset V) (Γ : Finset E) (e : Γ) :
    Related incidence A Γ e e := Relation.EqvGen.refl e

theorem related_symm (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    {e f : Γ} (h : Related incidence A Γ e f) : Related incidence A Γ f e :=
  Relation.EqvGen.symm _ _ h

theorem related_trans (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    {e f g : Γ} (h : Related incidence A Γ e f) (h' : Related incidence A Γ f g) :
    Related incidence A Γ e g := Relation.EqvGen.trans _ _ _ h h'

/-- The actual component containing a specified selected edge. -/
def component (incidence : E → Finset V) (A : Finset V) (Γ : Finset E) (e : Γ) : Finset Γ := by
  classical
  exact Finset.univ.filter (Related incidence A Γ e)

/-- All distinct nonempty components of the selected graph. -/
def components (incidence : E → Finset V) (A : Finset V) (Γ : Finset E) : Finset (Finset Γ) :=
  Finset.univ.image (component incidence A Γ)

@[simp] theorem mem_component (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (e f : Γ) : f ∈ component incidence A Γ e ↔ Related incidence A Γ e f := by
  classical
  simp [component]

@[simp] theorem mem_own_component (incidence : E → Finset V) (A : Finset V)
    (Γ : Finset E) (e : Γ) : e ∈ component incidence A Γ e := by
  exact (mem_component incidence A Γ e e).mpr (related_refl incidence A Γ e)

theorem component_eq_of_related (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    {e f : Γ} (h : Related incidence A Γ e f) :
    component incidence A Γ e = component incidence A Γ f := by
  ext g
  simp only [mem_component]
  constructor
  · exact fun hg => related_trans incidence A Γ (related_symm incidence A Γ h) hg
  · exact fun hg => related_trans incidence A Γ h hg

/-- Components are equal precisely for equivalent selected edges. -/
theorem component_eq_iff (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (e f : Γ) : component incidence A Γ e = component incidence A Γ f ↔
      Related incidence A Γ e f := by
  constructor
  · intro h
    have hf := mem_own_component incidence A Γ f
    rw [← h] at hf
    exact (mem_component incidence A Γ e f).mp hf
  · exact component_eq_of_related incidence A Γ

/-- Different canonical components have disjoint selected edge sets. -/
theorem component_disjoint_of_ne (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (e f : Γ) (hne : component incidence A Γ e ≠ component incidence A Γ f) :
    Disjoint (component incidence A Γ e) (component incidence A Γ f) := by
  apply Finset.disjoint_left.mpr
  intro g hg hg'
  apply hne
  apply component_eq_of_related incidence A Γ
  exact related_trans incidence A Γ ((mem_component incidence A Γ e g).mp hg)
    (related_symm incidence A Γ ((mem_component incidence A Γ f g).mp hg'))

/-- The component partition exhausts all selected edges, including direct branch edges. -/
theorem components_cover (incidence : E → Finset V) (A : Finset V) (Γ : Finset E) :
    (components incidence A Γ).biUnion id = Finset.univ := by
  ext e
  simp only [Finset.mem_univ, iff_true]
  apply Finset.mem_biUnion.mpr
  refine ⟨component incidence A Γ e, ?_, mem_own_component incidence A Γ e⟩
  exact Finset.mem_image.mpr ⟨e, Finset.mem_univ _, rfl⟩

/-- Every member of the component partition is nonempty. -/
theorem component_nonempty (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (K : Finset Γ) (hK : K ∈ components incidence A Γ) : K.Nonempty := by
  obtain ⟨e, he, rfl⟩ := Finset.mem_image.mp hK
  exact ⟨e, mem_own_component incidence A Γ e⟩

/-- The outside vertices used by an edge block. -/
def outsideSupport (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (K : Finset Γ) : Finset V := (K.biUnion (fun e => incidence e)) \ A

/-- Sharing any outside vertex forces selected edges into the same component. -/
theorem related_of_shared_outside (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (e f : Γ) (v : V) (hv : v ∉ A) (he : v ∈ incidence e) (hf : v ∈ incidence f) :
    Related incidence A Γ e f := Relation.EqvGen.rel e f ⟨v, hv, he, hf⟩

/-- Canonical components never share outside vertices. -/
theorem outsideSupport_disjoint (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (e f : Γ) (hne : component incidence A Γ e ≠ component incidence A Γ f) :
    Disjoint (outsideSupport incidence A Γ (component incidence A Γ e))
      (outsideSupport incidence A Γ (component incidence A Γ f)) := by
  apply Finset.disjoint_left.mpr
  intro v hv hv'
  obtain ⟨hve, hvA⟩ := Finset.mem_sdiff.mp hv
  obtain ⟨hvf, _⟩ := Finset.mem_sdiff.mp hv'
  obtain ⟨g, hg, hgv⟩ := Finset.mem_biUnion.mp hve
  obtain ⟨k, hk, hkv⟩ := Finset.mem_biUnion.mp hvf
  apply hne
  apply component_eq_of_related incidence A Γ
  exact related_trans incidence A Γ ((mem_component incidence A Γ e g).mp hg)
    (related_trans incidence A Γ (related_of_shared_outside incidence A Γ g k v hvA hgv hkv)
      (related_symm incidence A Γ ((mem_component incidence A Γ f k).mp hk)))

/-- All edges incident to a used outside vertex lie in its single component. -/
theorem incident_edges_in_component (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (e g : Γ) (v : V) (hv : v ∉ A) (hg : g ∈ component incidence A Γ e)
    (hgv : v ∈ incidence g) (f : Γ) (hfv : v ∈ incidence f) :
    f ∈ component incidence A Γ e := by
  apply (mem_component incidence A Γ e f).mpr
  exact related_trans incidence A Γ ((mem_component incidence A Γ e g).mp hg)
    (related_of_shared_outside incidence A Γ g f v hv hgv hfv)

/-- Decomposition preserves the full degree at every outside vertex used by a component. -/
theorem component_degree_exact (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (e g : Γ) (v : V) (hv : v ∉ A) (hg : g ∈ component incidence A Γ e)
    (hgv : v ∈ incidence g) :
    ((component incidence A Γ e).filter (fun f : Γ => v ∈ incidence f)).card =
      ((Finset.univ : Finset Γ).filter (fun f : Γ => v ∈ incidence f)).card := by
  congr 1
  ext f
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · exact And.right
  · intro hf
    exact ⟨incident_edges_in_component incidence A Γ e g v hv hg hgv f hf, hf⟩

/-- Every direct edge entirely inside the branch set is its own component. -/
theorem direct_component_singleton (incidence : E → Finset V) (A : Finset V)
    (Γ : Finset E) (e : Γ) (he : incidence e ⊆ A) : component incidence A Γ e = {e} := by
  have hpres : ∀ {f g : Γ}, Related incidence A Γ f g → (f = e ↔ g = e) := by
    intro f g h
    induction h with
    | rel f g hfg =>
      obtain ⟨v, hvA, hvf, hvg⟩ := hfg
      constructor
      · intro hf; subst f; exact False.elim (hvA (he hvf))
      · intro hg; subst g; exact False.elim (hvA (he hvg))
    | refl f => rfl
    | symm f g h ih => exact ih.symm
    | trans f g k hfg hgk ihfg ihgk => exact ihfg.trans ihgk
  ext f
  simp only [mem_component, Finset.mem_singleton]
  constructor
  · intro h
    exact (hpres h).mp rfl
  · intro hf
    subst f
    exact related_refl incidence A Γ e

/-- The subtype representation of the selected graph preserves ordinary vertex degrees. -/
theorem full_degree_eq (incidence : E → Finset V) (Γ : Finset E) (v : V) :
    ((Finset.univ : Finset Γ).filter (fun e : Γ => v ∈ incidence e)).card =
      Expansion.degree incidence Γ v := by
  unfold Expansion.degree
  apply Finset.card_bij (fun e _ => e.val)
  · intro e he
    exact Finset.mem_filter.mpr ⟨e.property, (Finset.mem_filter.mp he).2⟩
  · intro e he f hf hef
    exact Subtype.ext hef
  · intro e he
    obtain ⟨heΓ, hev⟩ := Finset.mem_filter.mp he
    exact ⟨⟨e, heΓ⟩, by simpa using hev, rfl⟩

/-- The exact branch set, expressed on the complete finite vertex universe. -/
def branchVertices (incidence : E → Finset V) (Γ : Finset E) : Finset V :=
  Finset.univ.filter (fun v => 4 ≤ Expansion.degree incidence Γ v)

/-- Used nonbranch vertices of an even graph necessarily have degree two. -/
theorem outside_degree_two (incidence : E → Finset V) (Γ : Finset E)
    (heven : Expansion.IsEven incidence Γ) (v : V)
    (hv : v ∉ branchVertices incidence Γ) (e : Γ) (hev : v ∈ incidence e) :
    Expansion.degree incidence Γ v = 2 := by
  have hlow : Expansion.degree incidence Γ v < 4 := by
    simpa [branchVertices] using hv
  have hpos : 0 < Expansion.degree incidence Γ v := by
    apply Finset.card_pos.mpr
    exact ⟨e.val, Finset.mem_filter.mpr ⟨e.property, hev⟩⟩
  have hpar := Nat.even_iff.mp (heven v)
  omega

/-- Every used outside vertex has degree exactly two within its canonical component. -/
theorem component_outside_degree_two (incidence : E → Finset V) (Γ : Finset E)
    (heven : Expansion.IsEven incidence Γ) (e g : Γ) (v : V)
    (hv : v ∉ branchVertices incidence Γ)
    (hg : g ∈ component incidence (branchVertices incidence Γ) Γ e)
    (hgv : v ∈ incidence g) :
    ((component incidence (branchVertices incidence Γ) Γ e).filter
      (fun f : Γ => v ∈ incidence f)).card = 2 := by
  rw [component_degree_exact incidence (branchVertices incidence Γ) Γ e g v hv hg hgv,
    full_degree_eq]
  exact outside_degree_two incidence Γ heven v hv g hgv

/-- The family of distinct blocks is pairwise disjoint. -/
theorem components_pairwise_disjoint (incidence : E → Finset V) (A : Finset V) (Γ : Finset E) :
    (components incidence A Γ : Set (Finset Γ)).PairwiseDisjoint id := by
  intro K hK M hM hne
  obtain ⟨e, he, rfl⟩ := Finset.mem_image.mp hK
  obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hM
  exact component_disjoint_of_ne incidence A Γ e f hne

/-- The edge count of the selected graph is the sum of its component edge counts. -/
theorem component_card_sum (incidence : E → Finset V) (A : Finset V) (Γ : Finset E) :
    ∑ K ∈ components incidence A Γ, K.card = Γ.card := by
  have h := Finset.card_biUnion (components_pairwise_disjoint incidence A Γ)
  rw [components_cover] at h
  simpa using h.symm

/-- Every signed edge-weight product factors exactly over the canonical pieces. -/
theorem component_weight_product (incidence : E → Finset V) (A : Finset V) (Γ : Finset E)
    (w : E → ℝ) :
    ∏ K ∈ components incidence A Γ, ∏ e ∈ K, w e = ∏ e ∈ Γ, w e := by
  have h := Finset.prod_biUnion (f := fun e : Γ => w e)
    (components_pairwise_disjoint incidence A Γ)
  rw [components_cover] at h
  calc
    _ = ∏ e : Γ, w e := h.symm
    _ = _ := Finset.prod_attach Γ w

end SpinGlass.SKComponents
