import SpinGlass.SKCountedExtraction
import SpinGlass.SKCountedCandidates
import SpinGlass.SKCountedAlgebra

/-! The actual cached SK evaluator, followed by scalar extraction, independent
trials and bounded-cardinality branch enumeration. Every arithmetic counter is
obtained by composing the executed scalar and saved-array loops. -/
noncomputable section
namespace SpinGlass.SKCountedExecution
open scoped BigOperators
open ArithmeticEvaluation
variable {V : Type*} [Fintype V] [DecidableEq V]

/-- One complete trial executes root tables, primitive insertion and dense
algebra once, then reads the resulting coefficient array for extraction. -/
def trial {L : ℕ} (A : Finset V) (χ : SKActualEvaluator.Outside A → Fin L)
    (f : Finset V → ℝ) : Computation :=
  let prim := primitives (SKActualEvaluator.branch A) Subtype.val χ f
  let alg := SKCountedAlgebra.evaluator prim.value
    ((SKFastEvaluator.directPairs A.card).toList.map
      (fun p => (SKFastEvaluator.direct (L := L) (SKActualEvaluator.branch A) f p.1 p.2).coeff))
  let out := extract alg.value
  ⟨out.value, prim.operations + alg.operations + out.operations⟩

@[simp] theorem trial_value {L : ℕ} (A : Finset V)
    (χ : SKActualEvaluator.Outside A → Fin L) (f : Finset V → ℝ) :
    (trial A χ f).value = ∑ m ∈ Finset.range (L + 1),
      (ColoringProbability.probability L m)⁻¹ * SKActualEvaluator.byOutsideSize A χ f m := by
  simp only [trial, extract_value, SKCountedAlgebra.evaluator_value, primitives_value]
  simp only [SKActualEvaluator.byOutsideSize, SKFastEvaluator.byOutsideSize,
    SKFastEvaluator.coefficient, SKFastEvaluator.evaluate, SKDenseExecution.evaluator_correct]

theorem trial_operations_profile {L : ℕ} (A : Finset V)
    (χ : SKActualEvaluator.Outside A → Fin L) (f : Finset V → ℝ) :
    (trial A χ f).operations ≤
      SKOperationCount.trialWork (Fintype.card (SKActualEvaluator.Outside A)) A.card L := by
  let prim := primitives (SKActualEvaluator.branch A) Subtype.val χ f
  let es := (SKFastEvaluator.directPairs A.card).toList.map
      (fun p => (SKFastEvaluator.direct (L := L) (SKActualEvaluator.branch A) f p.1 p.2).coeff)
  have hp := primitives_operations_le (SKActualEvaluator.branch A) Subtype.val χ f
  have ha := SKCountedAlgebra.evaluator_operations_le prim.value es
  have he := extract_operations_le (SKCountedAlgebra.evaluator prim.value es).value
  have hd : es.length ≤ A.card ^ 2 := by
    simpa [es] using SKOperationCount.directPairs_card_le A.card
  have haa : (SKCountedAlgebra.evaluator prim.value es).operations ≤
      (L + A.card ^ 2) * SKCountedAlgebra.iterationWork A.card L :=
    ha.trans (Nat.mul_le_mul_right _ (Nat.add_le_add_left hd L))
  change prim.operations + (SKCountedAlgebra.evaluator prim.value es).operations +
    (extract (SKCountedAlgebra.evaluator prim.value es).value).operations ≤ _
  calc
    _ ≤ (SKOperationCount.tableWork (Fintype.card (SKActualEvaluator.Outside A)) A.card L +
          SKOperationCount.closureWork (Fintype.card (SKActualEvaluator.Outside A)) A.card L) +
        (L + A.card ^ 2) * SKCountedAlgebra.iterationWork A.card L +
          2 * SKOperationCount.registers A.card L := add_le_add (add_le_add hp haa) he
    _ = _ := by
      unfold SKOperationCount.trialWork SKOperationCount.algebraWork SKCountedAlgebra.iterationWork
      omega

theorem trial_operations_le {L : ℕ} (A : Finset V)
    (χ : SKActualEvaluator.Outside A → Fin L) (f : Finset V → ℝ) :
    (trial A χ f).operations ≤
      32 * (Fintype.card V + L + 1) ^ 4 * 4 ^ L * 36 ^ A.card := by
  have hw : Fintype.card (SKActualEvaluator.Outside A) ≤ Fintype.card V :=
    Fintype.card_subtype_le _
  have hp := trial_operations_profile A χ f
  have hm : SKOperationCount.trialWork (Fintype.card (SKActualEvaluator.Outside A)) A.card L ≤
      SKOperationCount.trialWork (Fintype.card V) A.card L := by
    unfold SKOperationCount.trialWork SKOperationCount.tableWork SKOperationCount.closureWork
    gcongr
  exact hp.trans (hm.trans (SKOperationCount.trialWork_bound _ _ _ (Finset.card_le_univ A)))

/-- Independent trials reuse the prepared edge array and average exactly once. -/
def average (L R : ℕ) (A : Finset V) (χ : Fin R → V → Fin L)
    (f : Finset V → ℝ) : Computation :=
  mul (literal (R : ℝ)⁻¹)
    (sumFinset Finset.univ (fun r => trial A (fun v => χ r v.val) f))

/-- Candidates are generated by the bounded-cardinality union; each retained
candidate is processed exactly once. -/
def estimator (D L R : ℕ) (χ : Finset V → Fin R → V → Fin L)
    (f : Finset V → ℝ) : Counted ℝ :=
  ofComputation (sumFinset (candidates V D) (fun A => average L R A (χ A) f))

@[simp] theorem estimator_value (D L R : ℕ)
    (χ : Finset V → Fin R → V → Fin L) (f : Finset V → ℝ) :
    (estimator D L R χ f).value = SKActualEvaluator.estimator D L R χ f := by
  simp only [estimator, ofComputation, sumFinset_value, average, mul, literal, trial_value,
    SKActualEvaluator.estimator]
  exact sum_candidates D _

/-- The executable arithmetic schedule has one absolute polynomial exponent. -/
theorem estimator_operations_le (D L R : ℕ) (hR : 0 < R)
    (χ : Finset V → Fin R → V → Fin L) (f : Finset V → ℝ) :
    (estimator D L R χ f).operations ≤
      64 * R * (Fintype.card V + L + 1) ^ 4 * 4 ^ L *
        (∑ b ∈ Finset.range (D + 1), (Fintype.card V).choose b * 36 ^ b) := by
  let P := (Fintype.card V + L + 1) ^ 4 * 4 ^ L
  have hP : 1 ≤ P := Nat.succ_le_of_lt (by dsimp [P]; positivity)
  have havg (A : Finset V) : (average L R A (χ A) f).operations + 1 ≤
      64 * R * P * 36 ^ A.card := by
    have ht : (∑ r : Fin R, (trial A (fun v => χ A r v.val) f).operations) ≤
        R * (32 * P * 36 ^ A.card) := by
      calc
        _ ≤ ∑ _r : Fin R, (32 * P * 36 ^ A.card) :=
          Finset.sum_le_sum (fun r _ => by simpa [P, Nat.mul_assoc] using trial_operations_le A (fun v => χ A r v.val) f)
        _ = _ := by simp
    have hpow : 1 ≤ 36 ^ A.card := Nat.succ_le_of_lt (by positivity)
    have hr : 1 ≤ R := hR
    have hm : R ≤ R * P * 36 ^ A.card := by
      calc
        R ≤ R * P := Nat.le_mul_of_pos_right _ (by omega)
        _ ≤ R * P * 36 ^ A.card := Nat.le_mul_of_pos_right _ (by positivity)
    simp only [average, mul, literal, sumFinset_operations, Finset.card_univ, Fintype.card_fin]
    nlinarith
  simp only [estimator, ofComputation, sumFinset_operations]
  have hc : (candidates V D).card = ∑ _A ∈ candidates V D, (1 : ℕ) := by simp
  rw [hc, ← Finset.sum_add_distrib]
  calc
    _ ≤ ∑ A ∈ candidates V D, 64 * R * P * 36 ^ A.card := Finset.sum_le_sum (fun A _ => havg A)
    _ = _ := by
      rw [← Finset.mul_sum, sum_candidates_card]
      dsimp [P]
      ring

end SpinGlass.SKCountedExecution
